DB_NAME=landscape
DB_USER=replace-with-a-database-user
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=3306
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Session cookie hardening
# 1 = always send the Secure flag, 0 = never. Unset follows NODE_ENV.
# Only set 1 when the site is served over HTTPS, or browsers will drop the cookie.
COOKIE_SECURE=0

# 1 = trust one X-Forwarded-For hop from a reverse proxy, so rate limiting
# buckets by real client IP instead of the proxy address.
TRUST_PROXY=0
